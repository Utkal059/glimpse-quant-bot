# ---------------------------------------------------------------------------
# glimpse-quant-bot configuration. Copy to `.env` and edit.
# Glimpse has NO sandbox: every API key trades real Bitcoin.
# The bot is paper-trading (dry_run=True) unless BOTH of these are true:
#   1. GLIMPSE_LIVE_TRADING=true below
#   2. the `--live` flag is passed on the command line
# ---------------------------------------------------------------------------

# Glimpse credentials (Settings -> Developer API Keys). Not needed for dry-run:
# market data, the WebSocket feed and /trades/estimate are all public.
GLIMPSE_API_KEY=
GLIMPSE_BASE_URL=https://main.bpmapi.io
GLIMPSE_LIVE_TRADING=false

# --- Bankroll ---------------------------------------------------------------
# 0.001 BTC = 100,000 sats = 100,000,000 millisats.
GQB_BANKROLL_SATS=100000

# --- Universe ---------------------------------------------------------------
# USD-quoted underlyings only. Ratio-denominated batches (XAUT/BTC in sats per
# ounce, WTI/BTC) are always skipped: see the USD asset-unit guard in config.py.
GQB_ASSETS=BTC,ETH,SOL,GOLD
GQB_MAX_HORIZON_HOURS=30
GQB_MIN_SECONDS_TO_EXPIRY=240

# --- Signal & execution thresholds (price points on the 0-100 scale) ---------
GQB_MIN_RAW_EDGE_POINTS=3.0
GQB_MIN_NET_EDGE_POINTS=2.5
# Calibrated to live depth: Glimpse topics hold only b = 13-40 contracts of
# liquidity, so one trade rarely offers more than ~150 sats of expected profit.
# 25 sats is 25x the 1-sat minimum commission. (A 250-sat floor never fills.)
GQB_MIN_EXPECTED_GAIN_SATS=25
GQB_LADDER=1,2,5,10,20
GQB_LADDER_MAX_CONTRACTS=400

# --- Sizing & portfolio guardrails -------------------------------------------
GQB_KELLY_FRACTION=0.35
GQB_MAX_BUCKET_FRACTION=0.15
GQB_MAX_TOPIC_FRACTION=0.35
GQB_DAILY_DRAWDOWN_LIMIT=0.06
GQB_MAX_OPEN_POSITIONS=12
GQB_MAX_ORDERS_PER_MINUTE=6

# --- Exit rules ---------------------------------------------------------------
GQB_TAKE_PROFIT_GAP_POINTS=1.0
GQB_INVALIDATION_DROP_POINTS=4.0

# --- Rate limit & timers -----------------------------------------------------
# Glimpse allows 60 requests / 60 s per key; keep headroom.
GQB_GLIMPSE_REQUESTS_PER_MINUTE=50
GQB_RESOLUTION_POLL_SECONDS=45
GQB_TICK_INTERVAL_SECONDS=5

# --- Storage & logging ---------------------------------------------------------
GQB_DATA_DIR=data
GQB_LOG_LEVEL=INFO
GQB_LOG_JSON=false
